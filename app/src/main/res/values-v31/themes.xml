<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ system splash: static icon on the dark app background, no animation. -->
<resources>
    <style name="Theme.ITV.Splash" parent="@style/Theme.ITV">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowSplashScreenBackground">@color/bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/app_icon</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
