<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape>
                    <corners android:radius="12dp" />
                    <solid android:color="#6620DCE6" />
                </shape>
            </item>
            <item
                android:left="2.5dp"
                android:top="2.5dp"
                android:right="2.5dp"
                android:bottom="2.5dp">
                <shape>
                    <solid android:color="#080F14" />
                    <corners android:radius="10dp" />
                    <stroke
                        android:width="2.5dp"
                        android:color="@color/cyan" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape>
                    <corners android:radius="12dp" />
                    <solid android:color="#6620DCE6" />
                </shape>
            </item>
            <item
                android:left="2.5dp"
                android:top="2.5dp"
                android:right="2.5dp"
                android:bottom="2.5dp">
                <shape>
                    <solid android:color="#080F14" />
                    <corners android:radius="10dp" />
                    <stroke
                        android:width="2.5dp"
                        android:color="@color/cyan" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape>
            <solid android:color="#00000000" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
