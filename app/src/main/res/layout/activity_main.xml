<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:layoutDirection="rtl"
    android:clipChildren="false">

    <FrameLayout
        android:id="@+id/heroBackdropContainer"
        android:layout_width="match_parent"
        android:layout_height="@dimen/home_hero_h"
        android:layout_gravity="top"
        android:clipChildren="true"
        android:clipToPadding="true">

        <View
            android:id="@+id/heroFallback"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#0A1524" />

        <app.itv.prototype.ui.StableImageView
            android:id="@+id/backdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="false"
            android:scaleType="matrix"
            android:contentDescription="@null" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/scrim_hero" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/home_hero_fade_h"
            android:layout_gravity="bottom"
            android:background="@drawable/scrim_hero_bottom" />
    </FrameLayout>

    <ScrollView
        android:id="@+id/libraryScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:focusable="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="start"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/heroTextContainer"
                android:layout_width="@dimen/home_hero_copy_w"
                android:layout_height="@dimen/home_hero_copy"
                android:orientation="vertical"
                android:gravity="top|start"
                android:layout_gravity="start"
                android:paddingStart="@dimen/home_pad"
                android:paddingEnd="@dimen/home_pad"
                android:paddingTop="118dp"
                android:paddingBottom="8dp"
                android:layoutDirection="rtl">

                <TextView
                    android:id="@+id/heroTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/home_hero_title_h"
                    android:maxWidth="268dp"
                    android:fontFamily="@font/byekan_family"
                    android:includeFontPadding="false"
                    android:gravity="center_vertical|start"
                    android:textColor="#F4F7FA"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:shadowColor="#66000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="8" />

                <LinearLayout
                    android:id="@+id/heroMetaRow"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layoutDirection="rtl">

                    <TextView
                        android:id="@+id/heroKindChip"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/byekan_family"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        android:textColor="#D5E0E3"
                        android:textSize="12sp"
                        android:background="@drawable/bg_meta_chip" />

                    <TextView
                        android:id="@+id/heroChip2"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/byekan_family"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        android:textColor="#D5E0E3"
                        android:textSize="12sp"
                        android:background="@drawable/bg_meta_chip"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/heroChip3"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/byekan_family"
                        android:includeFontPadding="false"
                        android:gravity="center"
                        android:textColor="#D5E0E3"
                        android:textSize="12sp"
                        android:background="@drawable/bg_meta_chip"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/heroActions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layoutDirection="rtl">

                    <Button
                        android:id="@+id/heroDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/home_action_h"
                        android:minWidth="80dp"
                        android:minHeight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:stateListAnimator="@null"
                        android:elevation="0dp"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="0dp"
                        android:text="@string/hero_details"
                        android:textSize="14sp"
                        android:textStyle="normal"
                        android:fontFamily="@font/byekan_family"
                        android:includeFontPadding="false"
                        android:background="@drawable/bg_button_pill"
                        android:textColor="#E0E6ED"
                        android:focusable="true"
                        android:focusableInTouchMode="true" />

                    <Button
                        android:id="@+id/heroPlay"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/home_action_h"
                        android:minWidth="136dp"
                        android:minHeight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:stateListAnimator="@null"
                        android:elevation="0dp"
                        android:layout_marginStart="10dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="14dp"
                        android:paddingVertical="0dp"
                        android:text="@string/hero_continue"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/byekan_family"
                        android:includeFontPadding="false"
                        android:drawableEnd="@drawable/ic_play_tiny"
                        android:drawablePadding="8dp"
                        android:background="@drawable/bg_primary_pill"
                        android:textColor="@color/bg"
                        android:focusable="true"
                        android:focusableInTouchMode="true" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/library"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="@dimen/home_pad"
                android:paddingEnd="@dimen/home_pad"
                android:paddingBottom="40dp" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/view_home_header" />

    <LinearLayout
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:paddingTop="56dp"
        android:paddingBottom="40dp"
        android:paddingHorizontal="@dimen/home_pad">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="76dp"
            android:src="@drawable/ic_empty_tv"
            android:contentDescription="@string/empty_title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/empty_title"
            android:textSize="22sp"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/byekan_family"
            android:includeFontPadding="false"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/empty_body"
            android:textSize="13sp"
            android:textColor="#8E9CA6"
            android:fontFamily="@font/byekan_family"
            android:includeFontPadding="false"
            android:gravity="center"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/emptySettings"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/home_action_h"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_primary_pill"
            android:text="@string/open_settings"
            android:textColor="@color/bg"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="@font/byekan_family"
            android:includeFontPadding="false"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingHorizontal="24dp" />
    </LinearLayout>
</FrameLayout>
