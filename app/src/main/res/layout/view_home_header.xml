<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/headerRoot"
    android:layout_width="match_parent"
    android:layout_height="@dimen/home_header_h"
    android:layout_gravity="top"
    android:paddingHorizontal="@dimen/home_pad"
    android:layoutDirection="rtl">

    <app.itv.prototype.ui.ItvLogoView
        android:id="@+id/brandLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="left|center_vertical"
        app:logoSize="@dimen/logo_size_home" />

    <LinearLayout
        android:id="@+id/navTabs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/bg_nav_container"
        android:paddingHorizontal="6dp"
        android:paddingVertical="4dp"
        android:layoutDirection="rtl">

        <Button
            android:id="@+id/navHome"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/home_nav_h"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="0dp"
            android:text="@string/back_home"
            android:textSize="13sp"
            android:background="@drawable/bg_nav_pill_home"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/vazirmatn_family"
            android:includeFontPadding="false"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <Button
            android:id="@+id/navLibrary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/home_nav_h"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:layout_marginStart="6dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="0dp"
            android:text="@string/nav_library"
            android:textSize="13sp"
            android:background="@drawable/bg_nav_pill"
            android:textColor="@color/muted"
            android:fontFamily="@font/vazirmatn_family"
            android:includeFontPadding="false"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <Button
            android:id="@+id/settings"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/home_nav_h"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:layout_marginStart="6dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="0dp"
            android:text="@string/settings"
            android:textSize="13sp"
            android:background="@drawable/bg_nav_pill"
            android:textColor="@color/muted"
            android:fontFamily="@font/vazirmatn_family"
            android:includeFontPadding="false"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <Button
            android:id="@+id/navSearch"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/home_nav_h"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:layout_marginStart="6dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="0dp"
            android:text="@string/nav_search"
            android:textSize="13sp"
            android:background="@drawable/bg_nav_pill"
            android:textColor="@color/muted"
            android:fontFamily="@font/vazirmatn_family"
            android:includeFontPadding="false"
            android:focusable="true"
            android:focusableInTouchMode="true" />
    </LinearLayout>
</FrameLayout>
