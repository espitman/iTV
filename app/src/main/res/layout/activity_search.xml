<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:layoutDirection="rtl"
    android:clipChildren="false">

    <include layout="@layout/view_home_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="@dimen/home_header_h"
        android:clipChildren="false">

        <EditText
            android:id="@+id/query"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="@dimen/home_pad"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_search_field"
            android:fontFamily="@font/byekan_family"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch"
            android:includeFontPadding="false"
            android:inputType="text"
            android:paddingHorizontal="16dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:textSize="15sp"
            android:focusable="true"
            android:focusableInTouchMode="true" />

        <TextView
            android:id="@+id/searchEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/home_pad"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/byekan_family"
            android:includeFontPadding="false"
            android:text="@string/search_empty"
            android:textColor="@color/muted"
            android:textSize="15sp"
            android:visibility="gone" />

        <GridView
            android:id="@+id/results"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="@dimen/home_pad"
            android:paddingBottom="28dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:columnWidth="@dimen/home_poster_w"
            android:horizontalSpacing="@dimen/home_poster_gap"
            android:verticalSpacing="12dp"
            android:numColumns="auto_fit"
            android:stretchMode="spacingWidthUniform"
            android:scrollbars="none" />
    </LinearLayout>
</FrameLayout>
