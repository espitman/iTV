<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/home_continue_w"
    android:layout_height="@dimen/home_continue_h"
    android:layout_marginEnd="@dimen/home_card_gap"
    android:background="@drawable/bg_card_poster"
    android:padding="@dimen/home_focus_pad"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:descendantFocusability="blocksDescendants"
    android:layoutDirection="rtl">

    <FrameLayout
        android:id="@+id/cardInner"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <app.itv.prototype.ui.StableImageView
            android:id="@+id/poster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="false"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="9sp"
            android:textColor="@color/text"
            android:fontFamily="@font/vazirmatn_family"
            android:includeFontPadding="false"
            android:layout_gravity="top|start"
            android:layout_margin="6dp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="3dp"
            android:background="@drawable/bg_number"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:paddingHorizontal="6dp"
            android:paddingBottom="5dp">

            <View
                android:id="@+id/progressTrack"
                android:layout_width="match_parent"
                android:layout_height="@dimen/home_progress_h"
                android:background="@drawable/bg_progress_track"
                android:visibility="invisible" />

            <View
                android:id="@+id/progress"
                android:layout_width="match_parent"
                android:layout_height="@dimen/home_progress_h"
                android:layout_gravity="start"
                android:transformPivotX="0dp"
                android:background="@drawable/bg_progress_fill"
                android:visibility="invisible" />
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
