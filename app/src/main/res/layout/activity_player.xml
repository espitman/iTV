<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:keepScreenOn="true">
  <androidx.media3.ui.PlayerView android:id="@+id/player" android:layout_width="match_parent" android:layout_height="match_parent" app:use_controller="false" />
  <LinearLayout android:id="@+id/controls" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/scrim_player" android:layoutDirection="ltr" android:orientation="vertical" android:padding="48dp" android:visibility="gone" android:clipChildren="false" android:clipToPadding="false" android:paddingTop="28dp" android:paddingBottom="22dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:orientation="horizontal" android:gravity="center_vertical">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▶" android:textSize="14sp" android:textColor="@color/bg" android:fontFamily="@font/byekan_family" android:includeFontPadding="false" android:padding="7dp" android:background="@drawable/bg_primary" />
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="iTV" android:textSize="15sp" android:textColor="@color/text" android:fontFamily="@font/byekan_family" android:includeFontPadding="false" android:layout_marginStart="7dp" android:layout_gravity="center_vertical" android:textStyle="bold" />
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="22dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="در حال پخش" android:textSize="9sp" android:textColor="@color/muted" android:fontFamily="@font/byekan_family" android:includeFontPadding="false" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/nowTitle" android:text="" android:textSize="15sp" android:textColor="@color/text" android:fontFamily="@font/byekan_family" android:includeFontPadding="false" android:textStyle="bold" android:layout_marginTop="4dp" android:visibility="gone" />
      </LinearLayout>
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/nowMeta" android:text="" android:textSize="11sp" android:textColor="@color/text" android:fontFamily="@font/byekan_family" android:includeFontPadding="false" android:background="@drawable/bg_panel" android:padding="10dp" />
    </LinearLayout>
    <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" android:background="@drawable/bg_panel" android:padding="14dp">
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:clipChildren="false" android:clipToPadding="false">
        <TextView android:id="@+id/timeCurrent" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/byekan_family" android:textColor="@color/text" android:textSize="11sp" />
        <TextView android:id="@+id/timelineTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:fontFamily="@font/byekan_family" android:textColor="@color/text" android:textSize="17sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/timeTotal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="@font/byekan_family" android:textColor="@color/text" android:textSize="11sp" />
      </LinearLayout>
      <androidx.media3.ui.DefaultTimeBar android:id="@+id/timeline" android:layout_width="match_parent" android:layout_height="26dp" android:focusable="true" android:focusableInTouchMode="true" android:layoutDirection="ltr" android:contentDescription="نوار زمان؛ چپ و راست برای جابه‌جایی ده ثانیه‌ای" app:played_color="@color/cyan" app:scrubber_color="@color/cyan" app:buffered_color="#7099AABB" app:bar_height="3dp" app:scrubber_enabled_size="8dp" app:scrubber_dragged_size="14dp" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center_vertical" android:clipChildren="false" android:clipToPadding="false">
        <ImageButton android:id="@+id/btnRestart" android:layout_width="36dp" android:layout_marginStart="0dp" android:layout_height="36dp" android:background="@drawable/bg_button" android:focusable="true" android:contentDescription="@string/from_start" android:padding="8dp" android:minWidth="0dp" android:minHeight="0dp" android:textColor="@color/text" android:layout_marginEnd="0dp" android:src="@drawable/ic_restart" android:scaleType="centerInside" android:tint="@color/control_icon" />
        <ImageButton android:id="@+id/btnRewind" android:layout_width="36dp" android:layout_marginStart="10dp" android:layout_height="36dp" android:background="@drawable/bg_button" android:focusable="true" android:contentDescription="@string/rewind" android:padding="8dp" android:minWidth="0dp" android:minHeight="0dp" android:textColor="@color/text" android:layout_marginEnd="0dp" android:src="@drawable/ic_rewind" android:scaleType="centerInside" android:tint="@color/control_icon" />
        <ImageButton android:id="@+id/btnPlay" android:layout_width="36dp" android:layout_marginStart="10dp" android:layout_height="36dp" android:background="@drawable/bg_button" android:focusable="true" android:contentDescription="@string/pause" android:padding="8dp" android:minWidth="0dp" android:minHeight="0dp" android:textColor="@color/text" android:layout_marginEnd="0dp" android:src="@drawable/ic_play" android:scaleType="centerInside" android:tint="@color/control_icon" />
        <ImageButton android:id="@+id/btnForward" android:layout_width="36dp" android:layout_marginStart="10dp" android:layout_height="36dp" android:background="@drawable/bg_button" android:focusable="true" android:contentDescription="@string/forward" android:padding="8dp" android:minWidth="0dp" android:minHeight="0dp" android:textColor="@color/text" android:layout_marginEnd="0dp" android:src="@drawable/ic_forward" android:scaleType="centerInside" android:tint="@color/control_icon" />
        <ImageButton android:id="@+id/btnNext" android:layout_width="36dp" android:layout_marginStart="10dp" android:layout_height="36dp" android:background="@drawable/bg_button" android:focusable="true" android:contentDescription="@string/next" android:padding="8dp" android:minWidth="0dp" android:minHeight="0dp" android:textColor="@color/text" android:layout_marginEnd="0dp" android:src="@drawable/ic_next" android:scaleType="centerInside" android:tint="@color/control_icon" />
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <ImageButton android:id="@+id/btnQuality" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginEnd="0dp" android:background="@drawable/bg_button" android:focusable="true" android:contentDescription="کیفیت پخش" android:padding="8dp" android:minWidth="0dp" android:minHeight="0dp" android:layout_marginStart="0dp" android:src="@drawable/ic_quality" android:scaleType="centerInside" android:tint="@color/control_icon" />
        <ImageButton android:id="@+id/btnSpeed" android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/bg_button" android:focusable="true" android:contentDescription="@string/speed" android:padding="8dp" android:minWidth="0dp" android:minHeight="0dp" android:textColor="@color/text" android:layout_marginStart="10dp" android:layout_marginEnd="0dp" android:src="@drawable/ic_speed" android:scaleType="centerInside" android:tint="@color/control_icon" />
        <ImageButton android:id="@+id/btnJump" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginStart="10dp" android:background="@drawable/bg_button" android:focusable="true" android:contentDescription="@string/jump" android:padding="8dp" android:minWidth="0dp" android:minHeight="0dp" android:textColor="@color/text" android:layout_marginEnd="0dp" android:src="@drawable/ic_jump" android:scaleType="centerInside" android:tint="@color/control_icon" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
  <LinearLayout android:id="@+id/speedPanel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|end" android:layout_margin="28dp" android:background="@drawable/bg_panel" android:orientation="horizontal" android:padding="10dp" android:visibility="gone" android:clipChildren="false" android:clipToPadding="false" />
  <LinearLayout android:id="@+id/jumpPanel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:background="@drawable/bg_panel" android:gravity="center" android:orientation="horizontal" android:padding="18dp" android:visibility="gone" android:clipChildren="false" android:clipToPadding="false">
    <Button android:id="@+id/jumpHour" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_button" android:focusable="true" android:minWidth="80dp" android:text="۰۰" android:textColor="@color/text" />
    <Button android:id="@+id/jumpMinute" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:background="@drawable/bg_button" android:focusable="true" android:minWidth="80dp" android:text="۰۰" android:textColor="@color/text" />
    <Button android:id="@+id/jumpSecond" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:background="@drawable/bg_button" android:focusable="true" android:minWidth="80dp" android:text="۰۰" android:textColor="@color/text" />
    <Button android:id="@+id/jumpGo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:background="@drawable/bg_button" android:focusable="true" android:text="@string/jump_apply" android:textColor="@color/text" />
  </LinearLayout>
  <Button android:id="@+id/skip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|right" android:layout_marginBottom="56dp" android:background="@drawable/bg_button" android:focusable="true" android:fontFamily="@font/byekan_family" android:minWidth="180dp" android:text="@string/skip_intro" android:textColor="@color/text" android:visibility="gone" android:layout_marginRight="48dp" android:minHeight="42dp" android:textSize="12sp" android:paddingHorizontal="16dp" android:drawableEnd="@drawable/ic_next" android:drawablePadding="12dp" />
  <LinearLayout android:id="@+id/nextCard" android:layout_width="340dp" android:layout_height="wrap_content" android:layout_gravity="center_vertical|right" android:background="@drawable/bg_panel" android:orientation="vertical" android:padding="12dp" android:visibility="gone" android:clipChildren="false" android:clipToPadding="false" android:layoutDirection="rtl" android:layout_marginRight="48dp">
    <TextView android:id="@+id/nextLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/byekan_family" android:text="@string/next_episode" android:textColor="@color/cyan" android:textSize="10sp" android:paddingBottom="10dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
      <ImageView android:id="@+id/nextImage" android:layout_width="126dp" android:layout_height="78dp" android:scaleType="centerCrop" android:contentDescription="تصویر قسمت بعد" android:background="@drawable/bg_card" />
      <TextView android:id="@+id/nextTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:fontFamily="@font/byekan_family" android:textColor="@color/text" android:textSize="18sp" android:textStyle="bold" android:layout_weight="1" android:layout_marginStart="12dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:clipChildren="false" android:clipToPadding="false">
      <Button android:id="@+id/nextPlay" android:layout_width="0dp" android:layout_height="30dp" android:layout_weight="1" android:background="@drawable/bg_primary" android:focusable="true" android:text="@string/play_next" android:textColor="@color/bg" android:minHeight="0dp" android:textSize="11sp" />
      <Button android:id="@+id/nextCancel" android:layout_width="wrap_content" android:layout_height="30dp" android:layout_marginStart="8dp" android:background="@drawable/bg_button" android:focusable="true" android:text="@string/cancel" android:textColor="@color/text" android:minHeight="0dp" android:textSize="11sp" />
    </LinearLayout>
  </LinearLayout>
  <FrameLayout android:id="@+id/resume" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" android:clipChildren="false" android:clipToPadding="false">
    <ImageView android:id="@+id/resumeBackdrop" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:contentDescription="@null" />
    <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/scrim" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false">
    <LinearLayout android:layout_width="360dp" android:layout_height="wrap_content" android:background="@drawable/bg_panel" android:gravity="right" android:orientation="vertical" android:padding="23dp" android:clipChildren="false" android:clipToPadding="false" android:layoutDirection="rtl">
      <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="•  ادامهٔ تماشا" android:textSize="9sp" android:textColor="@color/cyan" android:layout_marginBottom="14dp" />
      <TextView android:id="@+id/resumeTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="@font/byekan_family" android:textColor="@color/text" android:textSize="21sp" android:textStyle="bold" />
      <TextView android:id="@+id/resumeBody" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:fontFamily="@font/byekan_family" android:textColor="@color/muted" android:textSize="11sp" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:orientation="horizontal">
        <Button android:id="@+id/resumePlay" android:layout_width="0dp" android:layout_height="32dp" android:layout_marginTop="0dp" android:background="@drawable/bg_primary" android:focusable="true" android:fontFamily="@font/byekan_family" android:minHeight="0dp" android:text="@string/resume_action" android:textColor="@color/bg" android:layout_weight="2" android:textSize="12sp" />
        <Button android:id="@+id/resumeRestart" android:layout_width="0dp" android:layout_height="32dp" android:layout_marginTop="0dp" android:background="@drawable/bg_button" android:focusable="true" android:fontFamily="@font/byekan_family" android:minHeight="0dp" android:text="@string/restart_action" android:textColor="@color/text" android:layout_weight="1" android:layout_marginStart="6dp" android:textSize="10sp" />
      </LinearLayout>
    </LinearLayout>
    </LinearLayout>
  </FrameLayout>
  <LinearLayout android:id="@+id/overlay" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/scrim" android:gravity="center" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false">
    <ProgressBar android:id="@+id/spinner" android:layout_width="52dp" android:layout_height="52dp" android:indeterminateTint="@color/cyan" />
    <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:fontFamily="@font/byekan_family" android:gravity="center" android:paddingStart="40dp" android:paddingEnd="40dp" android:text="@string/loading" android:textColor="@color/text" android:textSize="20sp" />
    <Button android:id="@+id/retry" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:background="@drawable/bg_button" android:focusable="true" android:focusableInTouchMode="true" android:fontFamily="@font/byekan_family" android:minWidth="200dp" android:minHeight="52dp" android:text="@string/retry" android:textColor="@color/text" android:textStyle="bold" android:visibility="gone" />
  </LinearLayout>
</FrameLayout>
