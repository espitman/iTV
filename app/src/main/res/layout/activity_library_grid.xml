<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:clipChildren="false">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/catalog_header_h"
        android:paddingHorizontal="@dimen/catalog_pad"
        android:layoutDirection="rtl">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start|center_vertical"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/navBack"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:stateListAnimator="@null"
                android:elevation="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:paddingVertical="0dp"
                android:text="@string/back"
                android:textSize="12sp"
                android:textColor="@color/text"
                android:fontFamily="@font/byekan_family"
                android:includeFontPadding="false"
                android:background="@drawable/bg_catalog_back"
                android:drawableStart="@drawable/ic_back_chevron"
                android:drawablePadding="6dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:textAllCaps="false"
                android:nextFocusDown="@id/grid" />

            <TextView
                android:id="@+id/gridTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:textColor="@color/text"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="@font/byekan_family"
                android:includeFontPadding="false"
                android:focusable="false" />

            <TextView
                android:id="@+id/gridChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="@color/cyan"
                android:textSize="11sp"
                android:fontFamily="@font/byekan_family"
                android:includeFontPadding="false"
                android:background="@drawable/bg_catalog_chip"
                android:focusable="false" />
        </LinearLayout>

        <app.itv.prototype.ui.ItvLogoView
            android:id="@+id/brandLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            app:logoSize="@dimen/logo_size_home" />
    </FrameLayout>

    <GridView
        android:id="@+id/grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="@dimen/catalog_pad"
        android:paddingTop="4dp"
        android:paddingBottom="24dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:horizontalSpacing="16dp"
        android:verticalSpacing="16dp"
        android:numColumns="6"
        android:stretchMode="none"
        android:columnWidth="@dimen/catalog_min_column"
        android:scrollbars="none"
        android:listSelector="@android:color/transparent"
        android:drawSelectorOnTop="false"
        android:choiceMode="none"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:descendantFocusability="afterDescendants"
        android:nextFocusUp="@id/navBack" />
</LinearLayout>
