<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_settings_screen"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layoutDirection="rtl"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/settings_pad"
        android:paddingTop="22dp"
        android:paddingBottom="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:clipChildren="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/back"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_catalog_back"
            android:drawableStart="@drawable/ic_back_chevron"
            android:drawablePadding="6dp"
            android:elevation="0dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:fontFamily="@font/vazirmatn_family"
            android:includeFontPadding="false"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:paddingVertical="0dp"
            android:stateListAnimator="@null"
            android:text="@string/back"
            android:textAllCaps="false"
            android:textColor="@color/text"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/vazirmatn_family"
            android:includeFontPadding="false"
            android:text="@string/settings_connection_title"
            android:textColor="@color/text"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false">

        <LinearLayout
            android:layout_width="@dimen/settings_panel_w"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_settings_plate"
            android:clipChildren="false"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:paddingTop="22dp"
            android:paddingBottom="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/statusDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_settings_dot_off" />

                    <TextView
                        android:id="@+id/serverState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/vazirmatn_family"
                        android:includeFontPadding="false"
                        android:textColor="@color/text"
                        android:textSize="13sp" />
                </LinearLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/clientVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:textColor="#8E9BA8"
                    android:textDirection="ltr"
                    android:textSize="12sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:background="#1F2532" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:clipChildren="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:clipChildren="false"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/vazirmatn_family"
                        android:gravity="right"
                        android:includeFontPadding="false"
                        android:text="@string/settings_url_label"
                        android:textColor="#8E9BA8"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/url"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_settings_url"
                        android:fontFamily="sans-serif"
                        android:gravity="left|center_vertical"
                        android:includeFontPadding="false"
                        android:minHeight="34dp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:textColor="#38BDF8"
                        android:textDirection="ltr"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/vazirmatn_family"
                        android:gravity="right"
                        android:includeFontPadding="false"
                        android:text="@string/settings_pin_label"
                        android:textColor="#8E9BA8"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layoutDirection="ltr"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/pin0"
                            style="@style/Widget.ITV.PinDigit" />

                        <TextView
                            android:id="@+id/pin1"
                            style="@style/Widget.ITV.PinDigit"
                            android:layout_marginStart="8dp" />

                        <TextView
                            android:id="@+id/pin2"
                            style="@style/Widget.ITV.PinDigit"
                            android:layout_marginStart="8dp" />

                        <TextView
                            android:id="@+id/pin3"
                            style="@style/Widget.ITV.PinDigit"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="@dimen/settings_action_h"
                        android:layout_marginTop="14dp"
                        android:importantForAccessibility="no" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="196dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:background="@drawable/bg_settings_qr_well"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="12dp">

                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_settings_qr_face"
                        android:padding="6dp">

                        <ImageView
                            android:id="@+id/qr"
                            android:layout_width="@dimen/settings_qr"
                            android:layout_height="@dimen/settings_qr"
                            android:contentDescription="@string/qr_label"
                            android:scaleType="fitCenter" />

                        <TextView
                            android:id="@+id/qrEmpty"
                            android:layout_width="@dimen/settings_qr"
                            android:layout_height="@dimen/settings_qr"
                            android:fontFamily="@font/vazirmatn_family"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="@string/server_off"
                            android:textColor="#5C6B72"
                            android:textSize="13sp"
                            android:visibility="gone" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="@font/vazirmatn_family"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/settings_qr_caption"
                        android:textColor="#8E9BA8"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
    </LinearLayout>

    <include layout="@layout/view_screen_logo" />
</FrameLayout>
