<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:gravity="center_horizontal"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/posterFrame"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@drawable/bg_catalog_poster"
        android:clipChildren="false"
        android:duplicateParentState="true"
        android:padding="@dimen/catalog_focus_pad">

        <FrameLayout
            android:id="@+id/cardInner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:duplicateParentState="true">

            <app.itv.prototype.ui.StableImageView
                android:id="@+id/poster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="false"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/kind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="6dp"
                android:background="@drawable/bg_search_kind"
                android:fontFamily="@font/vazirmatn_family"
                android:includeFontPadding="false"
                android:paddingHorizontal="6dp"
                android:paddingVertical="3dp"
                android:textColor="@color/text"
                android:textSize="10sp" />

            <ImageView
                android:id="@+id/playOverlay"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="bottom|left"
                android:layout_margin="8dp"
                android:contentDescription="@null"
                android:duplicateParentState="true"
                android:src="@drawable/catalog_play_overlay" />
        </FrameLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="@font/vazirmatn_family"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/text"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:fontFamily="@font/vazirmatn_family"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/muted"
        android:textSize="11sp" />
</LinearLayout>
